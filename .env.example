# CyberSentinel Environment Configuration Example
# Copy to .env and adjust values if needed.

# Application Settings
CYBERSENTINEL_ENV=development
LOG_LEVEL=INFO

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=15

# Inference & Hardware
INFERENCE_BATCH_SIZE=5000
MAX_DISPLAY_RECORDS=500
ENABLE_JETSON_METRICS=auto
